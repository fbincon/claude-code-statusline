{
  "name": "statusline-runtime",
  "version": "1.8.0",
  "description": "Native task timing and optional advanced statusline observations",
  "author": {
    "name": "fbincon"
  },
  "license": "MIT",
  "homepage": "https://github.com/fbincon/claude-code-statusline",
  "userConfig": {
    "backendExecutable": {
      "type": "string",
      "title": "Backend executable",
      "description": "Absolute matching claude-statusline executable",
      "default": "claude-statusline"
    },
    "configDir": {
      "type": "string",
      "title": "Configuration directory",
      "description": "Owned Claude configuration directory",
      "default": ""
    },
    "backendVersion": {
      "type": "string",
      "title": "Expected backend version",
      "description": "Version bound by the installer",
      "default": ""
    },
    "nativeTiming": {
      "type": "boolean",
      "title": "Native task timing",
      "description": "Collect task lifecycle and waiting evidence",
      "default": true
    },
    "liveMetrics": {
      "type": "boolean",
      "title": "Advanced live metrics",
      "description": "Collect request, cost, tool and checklist metrics",
      "default": false
    }
  }
}
