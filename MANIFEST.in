include README.md
include README.zh-CN.md
include CHANGELOG.md
include CHANGELOG.zh-CN.md
recursive-include docs *.md *.png
exclude docs/MACOS_VALIDATION.md
recursive-include tests *.py
recursive-include tests/fixtures *.json
recursive-include src/claude_statusline/resources *.md
recursive-include src/claude_statusline/i18n/locales *.json
include src/claude_statusline/i18n/languages.json
recursive-include tools *.py
recursive-include mods/statusline-native *.json *.ts
prune mods/statusline-native/node_modules
prune mods/statusline-native/.claude-plugin/types
recursive-include mods/statusline-runtime *.json *.ts
prune mods/statusline-runtime/node_modules
prune mods/statusline-runtime/.claude-plugin/types
exclude docs/ROADMAP.md
exclude docs/ROADMAP.zh-CN.md
global-exclude .DS_Store *.py[cod]
include src/build_native.py

recursive-include tools/unicode *.json *.txt

recursive-include tools/migration/ts-02 *.ts *.json *.mjs
prune tools/migration/ts-02/node_modules
prune tools/migration/ts-02/dist
prune tools/migration/ts-02/src/generated
recursive-include docs/development/typescript-migration/ts-02 *.json
