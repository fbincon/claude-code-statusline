{
  "name": "claude-code-statusline-development",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/testing"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "clean": "node tools/typescript/clean.mjs",
    "build": "node tools/typescript/check-runtime.mjs && tsc -b",
    "typecheck": "npm run build",
    "docs:check": "node tools/typescript/check-runtime.mjs && node tools/checks/docs.ts",
    "mods:prepare": "npm run build && node dist/typescript/tools/acceptance/mod-types.js",
    "acceptance:power": "npm run build && node dist/typescript/tools/acceptance/power.js",
    "capture:render": "npm run build && node dist/typescript/tools/acceptance/render-capture.js",
    "capture:editor": "npm run build && node dist/typescript/tools/acceptance/editor-capture.js",
    "capture:setup-appearance": "npm run build && node dist/typescript/tools/acceptance/setup-appearance-capture.js",
    "release:gitee-notes": "npm run build && node dist/typescript/tools/release/gitee-notes.js",
    "benchmark": "npm run build && node dist/typescript/tools/benchmarks/run.js",
    "generate": "npm run build && node dist/typescript/tools/generation/resources.js",
    "generate:check": "npm run build && node dist/typescript/tools/generation/resources.js --check",
    "languages:coverage": "npm run build && node dist/typescript/tools/generation/resources.js --coverage",
    "test": "npm run build && node tools/typescript/test.mjs",
    "migration:inventory": "node dist/typescript/tools/migration/ts-03/inventory.js",
    "migration:receipt": "node dist/typescript/tools/migration/ts-03/receipt.js",
    "migration:capture": "node dist/typescript/tools/migration/ts-03/capture.js",
    "migration:compare": "node dist/typescript/tools/migration/ts-03/compare.js",
    "migration:inventory:ts04": "node dist/typescript/tools/migration/ts-04/inventory.js",
    "migration:inventory:ts05": "npm run build && node dist/typescript/tools/migration/ts-05/inventory.js",
    "migration:installed": "npm run test:installed --",
    "migration:official:ts04": "npm run build && node dist/typescript/tools/migration/ts-04/official-installed.js",
    "migration:host:ts04": "npm run build && node dist/typescript/tools/migration/ts-04/host-smoke.js",
    "acceptance:paid": "npm run build && node dist/typescript/tools/acceptance/paid.js",
    "candidate:build": "npm run build && node dist/typescript/tools/build/candidate.js",
    "candidate:verify": "npm run build && node dist/typescript/tools/build/verify.js",
    "check": "npm run build && node dist/typescript/tools/checks/all.js",
    "archive:check": "npm run build && node dist/typescript/tools/checks/archive.js",
    "reference:verify": "npm run build && node dist/typescript/tools/migration/ts-05/reference.js",
    "release:prepare": "npm run build && node dist/typescript/tools/release/prepare.js",
    "benchmark:compare": "npm run build && node dist/typescript/tools/benchmarks/compare.js",
    "acceptance:terminal": "npm run build && node dist/typescript/tools/acceptance/terminal.js",
    "test:installed": "npm run build && node dist/typescript/tools/acceptance/installed.js",
    "test:mods": "npm run build && node dist/typescript/tools/acceptance/mods.js",
    "release:build": "npm run build && node dist/typescript/tools/build/candidate.js --channel public",
    "release:verify": "npm run build && node dist/typescript/tools/build/verify.js --release",
    "release:downloads": "npm run build && node dist/typescript/tools/release/downloads.js",
    "test:runtime": "node tools/typescript/test.mjs --runtime",
    "actions:check": "node tools/typescript/check-runtime.mjs && node tools/checks/actions.ts",
    "test:native-capacity": "npm run build && node dist/typescript/tools/acceptance/native-capacity.js",
    "capture:native-capacity": "npm run build && node dist/typescript/tools/acceptance/native-capacity-pty.js",
    "ci:watch": "node tools/typescript/check-runtime.mjs && node tools/checks/ci-watch.ts",
    "ci:plan": "node tools/typescript/check-runtime.mjs && node tools/checks/impact-plan.ts",
    "ci:check": "node tools/typescript/check-runtime.mjs && node tools/checks/impact-runner.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
